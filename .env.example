# Cron (all /api/cron/* routes expect Authorization: Bearer <CRON_SECRET>)
# Generate: node -e "console.log(require('crypto').randomUUID())"
# Must match Vercel → Project → Settings → Environment Variables → CRON_SECRET
CRON_SECRET=

# Public site URL (emails, WhatsApp, PDFs, invite links). Production: https://centerhq.app
NEXT_PUBLIC_APP_URL=https://centerhq.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (AI natural language query)
ANTHROPIC_API_KEY=sk-ant-... # Get from console.anthropic.com

# Bosta (shipping)
BOSTA_API_KEY=
# Set in Vercel env vars — get from Bosta dashboard
BOSTA_WEBHOOK_SECRET=

# WhatsApp Cloud API
# Required for chq_vendor_new_order template (QR card order alerts to print vendor)
VENDOR_WHATSAPP_NUMBER=

WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
# Meta App Secret (App Settings → Basic) — used for inbound webhook HMAC; not the same as WHATSAPP_TOKEN / WHATSAPP_ACCESS_TOKEN
WHATSAPP_APP_SECRET=

# Inbound FAQ forward to sales (E.164 or local digits) when no keyword match
SALES_MANAGER_PHONE=

# Public WhatsApp for wa.me links (digits only, e.g. 201234567890). Required for marketing/support CTAs in the app UI.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Server-side admin WhatsApp (cron alerts, vendor failure). Digits or E.164; if unset, code uses NEXT_PUBLIC_SUPPORT_WHATSAPP.
ADMIN_WHATSAPP_NUMBER=

# --- PostHog (analytics)
# Browser PostHog project API key (see PostHogProvider).
NEXT_PUBLIC_POSTHOG_KEY=your-key-here
# PostHog ingest host; code defaults to US cloud if omitted.
NEXT_PUBLIC_POSTHOG_HOST=https://example.com

# --- Next.js / Vercel (usually auto-set on deploy; optional for local tooling)
# instrumentation.ts branches Sentry init on node vs edge.
NEXT_RUNTIME=placeholder
# Standard Node/Next build mode.
NODE_ENV=development
# Vercel CLI / platform markers (paymobGuardLogic, status routes).
VERCEL=placeholder
VERCEL_ENV=placeholder
# Hostname-only preview URL segment; used for absolute URL fallbacks in pages and cron.
VERCEL_URL=placeholder
# Next.js build phase guard in paymobGuardLogic.
NEXT_PHASE=placeholder
# Shown in health payload; injected on Vercel.
VERCEL_GIT_COMMIT_SHA=placeholder
# Optional canonical URL override used by several admin pages before VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Admin & internal
# Comma-separated phones authorized as super-admins for sensitive admin routes.
# AUTHORITY GRANT: a phone here confers full super-admin on its own, with no
# admin_users row behind it, so the holder is invisible to every in-app admin
# listing and to the audit trail (S10). Each entry must normalize to a valid
# Egyptian mobile E.164 (+20 then 10/11/12/15 + 8 digits) or it silently
# matches nobody.
#
# `npm run check:env` value-checks this variable — BUT ONLY WHERE THE REAL
# VALUE IS ACTUALLY IN THE ENVIRONMENT. check-env.ts reads the ambient process
# env and deliberately does NOT load .env files, so an ordinary local run
# prints "(not present in this environment — nothing to validate)" and checks
# nothing. It has teeth in a Vercel shell, in CI with the secret injected, or
# when you pass the value inline:
#   SUPER_ADMIN_PHONES='+201234567890' npm run check:env
# Only then does it print the masked entries, the grant count and the stable
# fingerprint that makes "extended by one extra number" visible.
#
# The stock value below is whitelisted as NOT CONFIGURED (a warning, like every
# other placeholder in this file), so exporting this file into a shell does not
# fail the check on a value nobody edited. A real entry that does not parse is
# still an error.
SUPER_ADMIN_PHONES=placeholder
# CEO phone for cron briefings, Paymob invoice flows, and token health alerts (digits/E.164).
CEO_PHONE=placeholder
# Secret for signing/verifying CSRF tokens (see src/lib/csrf.ts).
CSRF_SECRET=your-key-here
# Shared secret for verifying inbound Sentry webhooks.
SENTRY_WEBHOOK_SECRET=your-key-here

# --- CEO financials API (EGP; code supplies defaults if unset)
MONTHLY_FIXED_COSTS_EGP=2500
CARD_COGS_EGP=0

# --- Paymob
PAYMOB_API_KEY=your-key-here
PAYMOB_INTEGRATION_ID=placeholder
PAYMOB_IFRAME_ID=placeholder
# HMAC secret for Paymob webhook and signature helpers.
PAYMOB_HMAC_SECRET=your-key-here
# Saved-card auto-charge (Phase 1 engine). Dedicated RECURRING / MOTO integration
# id used for merchant-initiated charges (no customer present). This is a SEPARATE
# credential Eyad must request from his Paymob account manager — it does NOT exist
# yet. Until it is set, the saved-card engine returns
# 'recurring_integration_not_configured' and never charges. Leave as placeholder.
PAYMOB_RECURRING_INTEGRATION_ID=placeholder
# Optional: set to 'true' only when using Paymob's modern Intention API so the
# stored-credential / previous-transaction reference is replayed on the MIT
# charge. Classic MOTO replays it via the saved token itself; keep unset for that.
# PAYMOB_USE_INTENTION=false

# --- WhatsApp Cloud API (extra names)
# Meta Graph "WhatsApp Business phone number ID". Aliases: WHATSAPP_PHONE_ID, PHONE_NUMBER_ID (code checks all three).
WHATSAPP_PHONE_NUMBER_ID=placeholder
# Alias of WHATSAPP_PHONE_NUMBER_ID / PHONE_NUMBER_ID for the same Meta field.
WHATSAPP_PHONE_ID=placeholder
# Alias of WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_PHONE_ID for the same Meta field.
PHONE_NUMBER_ID=placeholder
# Long-lived system user access token for WhatsApp Cloud API (server).
WHATSAPP_TOKEN=your-key-here
# Same credential as WHATSAPP_TOKEN; used in src/lib/whatsapp.ts Graph calls.
WHATSAPP_ACCESS_TOKEN=your-key-here
# Meta App ID (token health cron debug).
WHATSAPP_APP_ID=placeholder
# Webhook verify token alternate name; code also reads WHATSAPP_WEBHOOK_VERIFY_TOKEN.
WHATSAPP_VERIFY_TOKEN=your-key-here

# --- Renewals (WhatsApp templates)
# IBAN string embedded in renewal reminder copy.
RENEWAL_BANK_IBAN=placeholder

# --- Bosta
# Tracking label prefix for Bosta references (sanitize alnum; default CHQ).
BOSTA_BUSINESS_PREFIX=CHQ

# --- Google Drive backup / purge
# Single-line JSON credentials for a Google service account (Drive API).
GOOGLE_SERVICE_ACCOUNT_JSON=placeholder
# Target Drive folder for automated backups.
BACKUP_DRIVE_FOLDER_ID=placeholder
# Google Shared Drive ID for backup destination. Get from drive.google.com/drive/u/0/folders/<ID>.
# Service account must be a Manager of this Shared Drive.
BACKUP_DRIVE_SHARED_DRIVE_ID=placeholder
# Optional admin phone for backup WhatsApp notifications.
BACKUP_NOTIFY_PHONE=placeholder

# --- Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://example.com
UPSTASH_REDIS_REST_TOKEN=your-key-here
