{
 "name": "centerhq",
 "version": "0.1.0",
 "private": true,
 "browserslist": [
  "> 0.5%",
  "last 2 versions",
  "not dead",
  "not ie 11",
  "Chrome >= 92",
  "Firefox >= 90",
  "Safari >= 15",
  "Edge >= 92"
 ],
 "scripts": {
  "dev": "next dev",
  "build": "npm run i18n:check && npm run check:bidi && npm run check:tolocale && npm run setup-fonts && node --max-old-space-size=8192 node_modules/next/dist/bin/next build",
  "i18n:check": "npx tsx scripts/check-i18n.ts",
  "check:bidi": "npx tsx scripts/check-bidi.ts",
  "check:tolocale": "npx tsx scripts/check-no-tolocalestring.ts",
  "check:env": "tsx scripts/check-env.ts",
  "security:audit": "npx tsx scripts/security-audit.ts",
  "verify:stabilization": "npm run i18n:check && npm run check:bidi && npm run check:tolocale",
  "analyze": "ANALYZE=true npm run build",
  "start": "next start",
  "lint": "eslint",
  "typecheck": "rimraf .next/types .next/dev/types && node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit",
  "generate-business-plan": "node scripts/generate-business-plan.mjs",
  "check-secrets": "node scripts/check-secret-rotation.js",
  "verify-backup": "node scripts/verify-backup.js",
  "setup-fonts": "node scripts/setup-fonts.mjs",
  "schema:snapshot": "bash scripts/schema/rebuild.sh db/schema.snapshot",
  "schema:check": "bash scripts/schema/rebuild.sh /tmp/fresh.snapshot && bash scripts/schema/check-drift.sh db/schema.snapshot /tmp/fresh.snapshot",
  "test:unit": "vitest run",
  "test:unit:watch": "vitest",
  "test:e2e": "playwright test",
  "test:e2e:ui": "playwright test --ui",
  "test:all": "npm run test:unit && npm run test:e2e"
 },
 "dependencies": {
  "@anthropic-ai/sdk": "^0.110.0",
  "@fontsource/cairo": "^5.2.7",
  "@fontsource/jetbrains-mono": "^5.2.8",
  "@sentry/nextjs": "^10.63.0",
  "@sparticuz/chromium-min": "^149.0.0",
  "@supabase/auth-helpers-nextjs": "^0.15.0",
  "@supabase/ssr": "^0.12.0",
  "@supabase/supabase-js": "^2.95.3",
  "@types/qrcode": "^1.5.6",
  "@upstash/ratelimit": "^2.0.8",
  "@upstash/redis": "^1.38.0",
  "@vercel/analytics": "^2.0.1",
  "@vercel/speed-insights": "^2.0.0",
  "bcryptjs": "^3.0.3",
  "canvas-confetti": "^1.9.4",
  "clsx": "^2.1.1",
  "exceljs": "^4.4.0",
  "googleapis": "^173.0.0",
  "html5-qrcode": "^2.3.8",
  "idb": "^8.0.3",
  "jspdf": "^4.2.1",
  "lucide-react": "^1.23.0",
  "next": "^16.2.10",
  "next-intl": "^4.13.1",
  "postcss": "^8.5.13",
  "posthog-js": "^1.396.6",
  "puppeteer-core": "^25.3.0",
  "qrcode": "^1.5.4",
  "react": "19.2.7",
  "react-dom": "19.2.7",
  "recharts": "^3.9.2",
  "server-only": "^0.0.1",
  "swr": "^2.4.2",
  "tailwind-merge": "^3.6.0",
  "zod": "^4.4.3",
  "zustand": "^5.0.14"
 },
 "devDependencies": {
  "@next/bundle-analyzer": "^16.2.10",
  "@playwright/test": "^1.61.1",
  "@tailwindcss/postcss": "^4",
  "@types/canvas-confetti": "^1.9.0",
  "@types/node": "^26",
  "@types/react": "^19",
  "@types/react-dom": "^19",
  "@vitest/ui": "^4.1.10",
  "babel-plugin-react-compiler": "1.0.0",
  "docx": "^9.7.1",
  "eslint": "^10",
  "eslint-config-next": "16.2.10",
  "rimraf": "^6.1.3",
  "tailwindcss": "^4",
  "tailwindcss-animate": "^1.0.7",
  "tsx": "^4.23.0",
  "typescript": "^6",
  "vite-tsconfig-paths": "^6.1.1",
  "vitest": "^4.1.2"
 },
 "overrides": {
  "protobufjs": "7.6.4",
  "tmp": "0.2.7",
  "vite": "8.1.2",
  "ws": "8.21.0"
 }
}
