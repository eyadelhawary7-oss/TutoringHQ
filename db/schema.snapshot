STORAGE_POLICY objects.Authenticated users can update logos cmd=UPDATE roles=authenticated using=(bucket_id = 'center-logos'::text) check=∅
STORAGE_POLICY objects.Authenticated users can upload logos cmd=INSERT roles=authenticated using=∅ check=(bucket_id = 'center-logos'::text)
STORAGE_POLICY objects.invoice_pdfs_authenticated_select_own_center cmd=SELECT roles=authenticated using=((bucket_id = 'invoice-pdfs'::text) AND ((storage.foldername(name))[1] = 'invoices'::text) AND ((storage.foldername(name))[2] IN ( SELECT (u.center_id)::text AS center_id FROM users u WHERE ((u.id = auth.uid()) AND (u.center_id IS NOT NULL))))) check=∅
STORAGE_POLICY objects.invoice_pdfs_service_role_all cmd=ALL roles=service_role using=(bucket_id = 'invoice-pdfs'::text) check=(bucket_id = 'invoice-pdfs'::text)
STORAGE_POLICY objects.service_role_pdf_all cmd=ALL roles=public using=(bucket_id = 'card-order-pdfs'::text) check=(bucket_id = 'card-order-pdfs'::text)
