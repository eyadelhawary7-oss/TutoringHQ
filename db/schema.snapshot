INDEX idx_academic_periods_center ON academic_periods def=CREATE INDEX idx_academic_periods_center ON public.academic_periods USING btree (center_id)
INDEX idx_academic_periods_dates ON academic_periods def=CREATE INDEX idx_academic_periods_dates ON public.academic_periods USING btree (center_id, start_date, end_date)
INDEX idx_academic_periods_year ON academic_periods def=CREATE INDEX idx_academic_periods_year ON public.academic_periods USING btree (academic_year_id)
INDEX idx_academic_years_center ON academic_years def=CREATE INDEX idx_academic_years_center ON public.academic_years USING btree (center_id)
INDEX idx_academic_years_center_current ON academic_years def=CREATE UNIQUE INDEX idx_academic_years_center_current ON public.academic_years USING btree (center_id) WHERE (is_current = true)
INDEX idx_access_attempts_result_at ON access_attempts def=CREATE INDEX idx_access_attempts_result_at ON public.access_attempts USING btree (result, at)
INDEX idx_access_attempts_session ON access_attempts def=CREATE INDEX idx_access_attempts_session ON public.access_attempts USING btree (session_id)
INDEX idx_admin_alerts_center ON admin_alerts def=CREATE INDEX idx_admin_alerts_center ON public.admin_alerts USING btree (center_id)
INDEX idx_admin_alerts_unresolved ON admin_alerts def=CREATE INDEX idx_admin_alerts_unresolved ON public.admin_alerts USING btree (is_resolved) WHERE (is_resolved = false)
INDEX idx_admin_payments_center ON admin_payments def=CREATE INDEX idx_admin_payments_center ON public.admin_payments USING btree (center_id)
INDEX idx_announcement_blasts_center ON announcement_blasts def=CREATE INDEX idx_announcement_blasts_center ON public.announcement_blasts USING btree (center_id)
INDEX idx_announcement_blasts_sent_by ON announcement_blasts def=CREATE INDEX idx_announcement_blasts_sent_by ON public.announcement_blasts USING btree (sent_by) WHERE (sent_by IS NOT NULL)
INDEX idx_assessment_scores_student ON assessment_scores def=CREATE INDEX idx_assessment_scores_student ON public.assessment_scores USING btree (student_id)
INDEX idx_assessments_group ON assessments def=CREATE INDEX idx_assessments_group ON public.assessments USING btree (group_id)
INDEX idx_attendance_overrides_created ON attendance_overrides def=CREATE INDEX idx_attendance_overrides_created ON public.attendance_overrides USING btree (created_at DESC)
INDEX idx_attendance_overrides_student ON attendance_overrides def=CREATE INDEX idx_attendance_overrides_student ON public.attendance_overrides USING btree (student_id)
INDEX idx_attendance_overrides_user ON attendance_overrides def=CREATE INDEX idx_attendance_overrides_user ON public.attendance_overrides USING btree (override_by_user_id)
INDEX idx_attendance_center_date ON attendance_scans def=CREATE INDEX idx_attendance_center_date ON public.attendance_scans USING btree (center_id, scanned_at DESC)
