CONSTRAINT academic_periods.academic_periods_academic_year_id_fkey type=f def=FOREIGN KEY (academic_year_id) REFERENCES academic_years(id) ON DELETE CASCADE
CONSTRAINT academic_periods.academic_periods_center_id_fkey type=f def=FOREIGN KEY (center_id) REFERENCES centers(id) ON DELETE CASCADE
CONSTRAINT academic_periods.academic_periods_period_type_check type=c def=CHECK ((period_type = ANY (ARRAY['exam'::text, 'holiday'::text, 'peak'::text, 'normal'::text])))
CONSTRAINT academic_periods.academic_periods_pkey type=p def=PRIMARY KEY (id)
CONSTRAINT academic_years.academic_years_center_id_fkey type=f def=FOREIGN KEY (center_id) REFERENCES centers(id) ON DELETE CASCADE
CONSTRAINT academic_years.academic_years_pkey type=p def=PRIMARY KEY (id)
CONSTRAINT access_attempts.access_attempts_by_user_id_fkey type=f def=FOREIGN KEY (by_user_id) REFERENCES users(id) ON DELETE SET NULL
