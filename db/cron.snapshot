CRON_JOB backup-check-daily schedule=0 4 * * * active=true command= INSERT INTO public.backup_log (checked_at, status, notes) VALUES ( now(), CASE WHEN (SELECT last_verified_at FROM public.backup_log ORDER BY checked_at DESC LIMIT 1) IS NULL OR (SELECT last_verified_at FROM public.backup_log ORDER BY checked_at DESC LIMIT 1) < now() - interval '36 hours' THEN 'alert' ELSE 'ok' END, 'pg_cron backup check at 4am UTC' );
